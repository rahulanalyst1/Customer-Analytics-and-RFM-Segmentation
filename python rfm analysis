import pandas as pd

df = pd.read_csv('clean_ikea_file.csv', header=None)

df.columns = [
    'invoice', 'stockcode', 'description',
    'quantity', 'invoicedate', 'price',
    'customer_id', 'country', 'Sourcecode'
]

df['invoicedate'] = pd.to_datetime(df['invoicedate'])

print(df.shape)
df.info()

# FILTER AND CALCULATE RECENCY, FREQUENCY, MONETARY

rfm_data = df[
    (df['customer_id'].notna()) &
    (df['quantity'] > 0)
].copy()

snapshot_date = pd.to_datetime('2011-12-10')

rfm = rfm_data.groupby('customer_id').agg(
    Recency=('invoicedate', lambda x: (snapshot_date - x.max()).days),
    Frequency=('invoice', 'nunique'),
    Monetary=('quantity', lambda x: (
        x * rfm_data.loc[x.index, 'price']
    ).sum())
).reset_index()


# 1. Calculate RFM Scores

rfm['R_Score'] = pd.qcut(
    rfm['Recency'], 5, labels=[5, 4, 3, 2, 1]
).astype(int)

rfm['F_Score'] = pd.qcut(
    rfm['Frequency'].rank(method='first'), 5, labels=[1, 2, 3, 4, 5]
).astype(int)

rfm['M_Score'] = pd.qcut(
    rfm['Monetary'].rank(method='first'), 5, labels=[1, 2, 3, 4, 5]
).astype(int)


# 2. Assign Customer Segments

def segment_customer(row):

    if row['R_Score'] >= 4 and row['F_Score'] >= 4 and row['M_Score'] >= 4:
        return 'Champions'

    elif row['R_Score'] >= 3 and row['F_Score'] >= 3:
        return 'Loyal Customers'

    elif row['R_Score'] <= 2 and row['F_Score'] >= 3:
        return 'At Risk'

    elif row['R_Score'] >= 4 and row['F_Score'] <= 2:
        return 'New Customers'

    elif row['R_Score'] == 3 and row['F_Score'] <= 2:
        return 'Needs Attention'

    else:
        return 'Lost Customers'


# 3. Apply Customer Segmentation

rfm['Segment'] = rfm.apply(segment_customer, axis=1)


# 4. Identify Churned Customers

rfm['IsChurned'] = rfm['Recency'] > 90


# 5. Check Results

print(rfm.head())

# MERGE RFM RESULTS BACK ONTO TRANSACTIONS AND EXPORT

# Remove rows with missing Customer ID and invalid Quantity
df = df[(df['customer_id'].notna()) & (df['quantity'] > 0)].copy()

# Create Invoice Month
df['InvoiceMonth'] = df['invoicedate'].dt.to_period('M').dt.to_timestamp()

# Calculate Revenue
df['Revenue'] = df['quantity'] * df['price']

# Merge RFM results with transaction data
df_final = df.merge(
    rfm[['customer_id', 'Recency', 'Frequency', 'Monetary',
         'R_Score', 'F_Score', 'M_Score', 'Segment', 'IsChurned']],
    on='customer_id',
    how='left'
)

# Export final dataset to Excel
df_final.to_excel('EcommerceDashboardData.xlsx', index=False)

